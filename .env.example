# Plantilla de variables de entorno. Copia este fichero según el entorno:
#
#   - PRODUCCIÓN  -> .env         (BD de producción; se usa con `npm start`,
#                                  que fija NODE_ENV=production y carga SOLO .env)
#   - DESARROLLO  -> .env.local   (BD de desarrollo; `npm run dev` y los tests
#                                  cargan .env + .env.local, y .env.local tiene
#                                  prioridad, así nunca tocan la BD de producción)
#
# Ninguno de los dos se versiona (ver .gitignore). Nunca subas credenciales.
# La lógica de carga está en src/env.ts.

# Cadena de conexión directa a Postgres (Supabase).
# En Supabase: Project Settings → Database → Connection string → "Transaction pooler".
# El pooler (puerto 6543, PgBouncer en modo transacción) es el recomendado para
# el backend; el cliente usa prepare:false por ese motivo.
# Si la contraseña lleva caracteres especiales (#, @, ...), percent-encódeala y
# entrecomilla el valor.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
